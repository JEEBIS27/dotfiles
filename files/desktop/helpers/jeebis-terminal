#!/usr/bin/env bash
set -euo pipefail
app_id=org.jeebis.rio
cwd=$PWD
while [[ $# -gt 0 ]]; do
  case $1 in
    --app-id=*) app_id=${1#*=}; shift ;;
    --cwd) cwd=$2; shift 2 ;;
    --dir=*) cwd=${1#*=}; shift ;;
    --|-e) shift; break ;;
    *) break ;;
  esac
done
exec rio --app-id "$app_id" --working-dir "$cwd" -e jeebis-tuios "$@"
