#!/usr/bin/env bash
set -euo pipefail
# This launcher deliberately has no compositor or multiplexer dependency.
unset NO_COLOR JEEBIS_TUIOS_ROLE JEEBIS_TUIOS_CODEX
app_id=
cwd=$PWD
while [[ $# -gt 0 ]]; do
  case $1 in
    --app-id=*) app_id=${1#*=}; shift ;;
    --cwd) cwd=$2; shift 2 ;;
    --dir=*) cwd=${1#*=}; shift ;;
    --|-e) shift; break ;;
    *) break ;;
  esac
done
args=(--working-directory="$cwd")
[[ -z $app_id ]] || args+=(--class="$app_id")
# New windows must inherit this invocation's environment and command.
args+=(--gtk-single-instance=false)
if [[ $# == 0 ]]; then
  exec ghostty "${args[@]}"
fi
exec ghostty "${args[@]}" -e "$@"
