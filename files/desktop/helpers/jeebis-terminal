#!/usr/bin/env bash
set -euo pipefail
# GUI terminals should negotiate their own color capability.
unset NO_COLOR JEEBIS_TUIOS_ROLE JEEBIS_TUIOS_CODEX
app_id=
cwd=$PWD
while [[ $# -gt 0 ]]; do
  case $1 in
    --app-id=*) app_id=${1#*=}; shift ;;
    --cwd) cwd=$2; shift 2 ;;
    --dir=*) cwd=${1#*=}; shift ;;
    --|-e) shift; break ;;
    *) break ;;
  esac
done
args=()
[[ -z $app_id ]] || args+=(--app-id "$app_id")
args+=(--working-dir "$cwd")
# Make every new Rio's child command explicit. Rio may already be running
# with a Codex launch environment, so clean role flags inside the child too.
child=(env -u JEEBIS_TUIOS_CODEX -u JEEBIS_TUIOS_ROLE)
if [[ $# == 0 ]]; then
  exec rio "${args[@]}" -e "${child[@]}" JEEBIS_TUIOS_ROLE=desktop jeebis-tuios
fi
case $app_id in
  org.omarchy.yazi) role=yazi ;;
  org.omarchy.codex) role=codex ;;
  *) role=$(basename -- "$1") ;;
esac
child+=("JEEBIS_TUIOS_ROLE=$role")
[[ $role != codex ]] || child+=(JEEBIS_TUIOS_CODEX=1)
exec rio "${args[@]}" -e "${child[@]}" jeebis-tuios "$@"
