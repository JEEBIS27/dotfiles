#!/usr/bin/env bash
set -euo pipefail
# GUI terminals should negotiate their own color capability.
unset NO_COLOR
app_id=
cwd=$PWD
while [[ $# -gt 0 ]]; do
  case $1 in
    --app-id=*) app_id=${1#*=}; shift ;;
    --cwd) cwd=$2; shift 2 ;;
    --dir=*) cwd=${1#*=}; shift ;;
    --|-e) shift; break ;;
    *) break ;;
  esac
done
args=()
[[ -z $app_id ]] || args+=(--app-id "$app_id")
args+=(--working-dir "$cwd")
# A plain Rio uses its configured shell (tuios new), just like the app launcher.
if [[ $# == 0 ]]; then exec rio "${args[@]}"; fi
exec rio "${args[@]}" -e jeebis-tuios "$@"
