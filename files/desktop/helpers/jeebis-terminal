#!/usr/bin/env bash
set -euo pipefail
# GUI terminals should negotiate their own color capability.
unset NO_COLOR JEEBIS_TUIOS_ROLE
app_id=
cwd=$PWD
while [[ $# -gt 0 ]]; do
  case $1 in
    --app-id=*) app_id=${1#*=}; shift ;;
    --cwd) cwd=$2; shift 2 ;;
    --dir=*) cwd=${1#*=}; shift ;;
    --|-e) shift; break ;;
    *) break ;;
  esac
done
args=()
[[ -z $app_id ]] || args+=(--app-id "$app_id")
args+=(--working-dir "$cwd")
# A plain Rio uses its configured shell (resume the last TUIOS session), just like the app launcher.
if [[ $# == 0 ]]; then exec rio "${args[@]}"; fi
case $app_id in
  org.omarchy.yazi) export JEEBIS_TUIOS_ROLE=yazi ;;
  org.omarchy.codex) export JEEBIS_TUIOS_ROLE=codex ;;
  *) export JEEBIS_TUIOS_ROLE=$(basename -- "$1") ;;
esac
exec rio "${args[@]}" -e jeebis-tuios "$@"
