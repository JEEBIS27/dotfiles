#!/usr/bin/env bash
set -euo pipefail
printf 'New worktree branch (empty cancels): '
IFS= read -r branch
[[ -n "$branch" ]] || exit 0
# Worktree sessions are created headless: never attach a nested TUIOS client.
# The native sidebar/session switcher can then open the new session.
if tuios worktree new --detach -- "$branch"; then
  printf '\nCreated. Select the session in the sidebar (Alt+B).\n'
else
  printf '\nWorktree creation failed; see the error above.\n' >&2
fi
read -r -p 'Press Enter to close.' _
