// Niri session. Machine-specific outputs are added by host modules.
@machine@

layout {
    // Hyprland gaps_in=2 on each side, gaps_out=4.
    gaps 4
    center-focused-column "never"
    default-column-width { proportion 0.5; }
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }
    focus-ring { on; }
    border { off; }
}
include optional=true @battery-focus-ring@
// Final Hyprland curvature override also applies to floating windows.
window-rule {
    geometry-corner-radius 15
    clip-to-geometry true
    background-effect { blur true; xray false; }
}
window-rule {
    match is-active=false
    opacity 0.9
}
// Blur the actual content behind Tide while letting it define the blur region.
layer-rule {
    match namespace="^tide-island$"
    background-effect { xray false; }
}
// Approximate the old two-pass blur without saturation or added noise.
blur { passes 2; offset 4; noise 0; saturation 1.0; }
prefer-no-csd
hotkey-overlay { skip-at-startup; }
environment {
    NIXOS_OZONE_WL "1"
    ELECTRON_OZONE_PLATFORM_HINT "wayland"
    OZONE_PLATFORM "wayland"
    QT_IM_MODULE "fcitx"
    QT_IM_MODULES "fcitx"
    XMODIFIERS "@im=fcitx"
    GDK_BACKEND "wayland,x11"
    QT_QPA_PLATFORM "wayland;xcb"
    MOZ_ENABLE_WAYLAND "1"
}
@workspaces@
binds {
    @applications@
    @workspace-bindings@
    // Plain Ghostty bypasses the placement helper and all legacy launchers.
    Mod+Alt+Return { spawn "@terminal@" "--app-id=org.jeebis.terminal"; }
    Mod+Return { spawn "@actions@" "launch" "terminal-tmux"; }
    Mod+Shift+Return { spawn "@actions@" "launch" "terminal-tmux" "--below"; }
    Mod+O hotkey-overlay-title="Overview" { toggle-overview; }
    Mod+F { spawn "@desktop@" "shell" "tide" "toggleApplicationLauncher"; }
    Mod+Shift+F { spawn "@key-search@"; }
    Mod+Ctrl+F { spawn "@actions@" "search-windows"; }
    Mod+U hotkey-overlay-title="1Password Quick Access" { spawn "1password" "--quick-access"; }
    Mod+Shift+Escape { spawn "@desktop@" "settings"; }
    Mod+Space { spawn "@desktop@" "shell" "tide" "toggleControlCenter"; }
    Mod+M { spawn "@desktop@" "shell" "tide" "togglePlayer"; }
    Mod+Ctrl+V { spawn "@desktop@" "shell" "tide" "toggleClipboard"; }
    Mod+Ctrl+D { spawn "@desktop@" "shell" "tide" "toggleCalendar"; }
    Mod+Ctrl+W { spawn "@desktop@" "shell" "tide" "toggleWeather"; }
    Mod+Ctrl+Space { spawn "@desktop@" "shell" "tide" "toggleWallpaperPicker"; }
    Mod+N { spawn "@desktop@" "shell" "tide" "toggleNotificationCenter"; }
    Mod+@mod:I@ repeat=false { spawn "@desktop@" "shell" "island" "peek"; }
    Mod+Shift+@mod:I@ { spawn "@desktop@" "shell" "island" "toggle"; }
    Mod+Alt+T { spawn "@desktop@" "theme" "cycle"; }
    Mod+W { close-window; }
    Mod+Shift+W { spawn "@actions@" "close-workspace"; }
    Mod+@mod:H@ { focus-column-left; }
    Mod+Shift+@mod:H@ { spawn "@resize@" "shrink"; }
    Mod+Ctrl+@mod:H@ { swap-window-left; }
    Mod+Ctrl+Shift+@mod:H@ { move-column-left; }
    Mod+Left { focus-column-left; }
    Mod+Shift+Left { spawn "@resize@" "shrink"; }
    Mod+Ctrl+Left { swap-window-left; }
    Mod+Ctrl+Shift+Left { move-column-left; }
    Mod+@mod:J@ { focus-window-down; }
    Mod+Shift+@mod:J@ { set-window-height "+10%"; }
    Mod+Ctrl+@mod:J@ { move-window-down; }
    Mod+Ctrl+Shift+@mod:J@ { move-window-down; }
    Mod+Down { focus-window-down; }
    Mod+Shift+Down { set-window-height "+10%"; }
    Mod+Ctrl+Down { move-window-down; }
    Mod+Ctrl+Shift+Down { move-window-down; }
    Mod+@mod:K@ { focus-window-up; }
    Mod+Shift+@mod:K@ { set-window-height "-10%"; }
    Mod+Ctrl+@mod:K@ { move-window-up; }
    Mod+Ctrl+Shift+@mod:K@ { move-window-up; }
    Mod+Up { focus-window-up; }
    Mod+Shift+Up { set-window-height "-10%"; }
    Mod+Ctrl+Up { move-window-up; }
    Mod+Ctrl+Shift+Up { move-window-up; }
    Mod+@mod:L@ { focus-column-right; }
    Mod+Shift+@mod:L@ { spawn "@resize@" "grow"; }
    Mod+Ctrl+@mod:L@ { swap-window-right; }
    Mod+Ctrl+Shift+@mod:L@ { move-column-right; }
    Mod+Right { focus-column-right; }
    Mod+Shift+Right { spawn "@resize@" "grow"; }
    Mod+Ctrl+Right { swap-window-right; }
    Mod+Ctrl+Shift+Right { move-column-right; }
    Mod+Tab { focus-workspace-down; }
    Mod+Shift+Tab { focus-workspace-up; }
    Mod+Ctrl+Tab { focus-workspace-previous; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+Shift+Page_Down { focus-monitor-next; }
    Mod+Shift+Page_Up { focus-monitor-previous; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-window-to-workspace-down; }
    Mod+Ctrl+Page_Up { move-window-to-workspace-up; }
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { spawn "@actions@" "toggle-maximize"; }
    Mod+Ctrl+R { fullscreen-window; }
    Mod+T { switch-focus-between-floating-and-tiling; }
    Mod+Shift+T { toggle-window-floating; }
    Mod+Ctrl+T { toggle-column-tabbed-display; }
    Mod+Alt+Shift+J { toggle-column-tabbed-display; }
    Mod+X { spawn "@actions@" "clipboard" "cut"; }
    Mod+C { spawn "@actions@" "clipboard" "copy"; }
    Mod+V { spawn "@actions@" "clipboard" "paste"; }
    Mod+comma { consume-or-expel-window-left; }
    Mod+period { consume-or-expel-window-right; }
    Mod+Ctrl+Escape { spawn "@desktop@" "shell" "tide" "togglePowerMenu"; }
    Mod+Escape { spawn "@desktop@" "lock"; }
    Mod+Shift+S { screenshot; }
    Print { screenshot; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.05+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.05-"; }
    XF86AudioMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86MonBrightnessUp { spawn "brightnessctl" "set" "5%+"; }
    XF86MonBrightnessDown { spawn "brightnessctl" "set" "5%-"; }
}
