[Unit]
Description=Mount OneDrive with rclone
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStartPre=-/usr/bin/fusermount -u %h/OneDrive
ExecStart=/usr/bin/rclone mount onedrive: %h/OneDrive --vfs-cache-mode writes --allow-non-empty
ExecStop=/usr/bin/fusermount -u %h/OneDrive
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target

