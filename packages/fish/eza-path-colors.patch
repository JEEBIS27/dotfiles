+    /// Resolve exactly one existing path, without executing substitutions or globbing.
+    pub fn eza_style(&mut self, token: &wstr, for_cd: bool) -> Option<super::eza_style::EzaStyle> {
+        if self.ctx.vars().get(L!("fish_color_path_by_type"))?.as_string() != L!("1")
+            || token.len() > PATH_MAX as usize || self.ctx.check_cancel() {
+            return None;
+        }
+        let mut path = token.to_owned();
+        if !expand_one(&mut path, ExpandFlags::NO_IO, self.ctx, None) { return None; }
+        let expanded = path;
+        let mut path = path_apply_working_directory(&expanded, self.working_directory);
+        // Keep the final symlink (including link-to-directory) instead of following '/'.
+        while path.len() > 1 && path.char_at(path.len() - 1) == '/' { path.pop(); }
+        if for_cd && crate::wutil::lwstat(&path).is_err() {
+            path = crate::path::path_get_cdpath(&expanded, self.working_directory, self.ctx.vars())?;
+        }
+        super::eza_style::style_for(&path, self.ctx.vars())
+    }
