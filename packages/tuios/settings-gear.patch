index 0000000..501296a
--- /dev/null
+++ 2/internal/app/gear.go
@@ -0,0 +1,250 @@
+package app
+
+import (
+	"fmt"
+	"image"
+	"strings"
+
+	tea "charm.land/bubbletea/v2"
+	"charm.land/lipgloss/v2"
+	"github.com/Gaurav-Gosain/tuios/internal/config"
+	"github.com/Gaurav-Gosain/tuios/internal/theme"
+	uv "github.com/charmbracelet/ultraviolet"
+	"github.com/charmbracelet/x/ansi"
+)
+
+// GearAt owns only the three cells painted by the gear. All other input keeps
+// going to the pane, even when its first row is under the gear.
+func (m *OS) GearAt(x, y int) bool {
+	return x >= m.gearX() && x < m.GetRenderWidth() && y >= 0 && y < m.GetRenderHeight() && y == m.gearY()
+}
+
+func (m *OS) gearX() int { return max(0, m.GetRenderWidth()-3) }
+
+func (m *OS) gearY() int {
+	if m.Settings.DockbarPosition == "bottom" {
+		return max(0, m.GetRenderHeight()-m.Settings.DockHeight())
+	}
+	return 0
+}
+
+// OpenGearMenu builds rows from the same action registry used by keybindings.
+// No row sends a synthetic key to a guest terminal.
+func (m *OS) OpenGearMenu(group string) {
+	m.CloseContextMenu()
+	cm := &ContextMenu{Title: "TUIOS", AnchorX: m.gearX(), AnchorY: m.gearY() + 1, Selected: -1, ItemH: 1,
+		WindowIndex: m.FocusedWindow, Workspace: m.CurrentWorkspace}
+	add := func(label, action string) {
+		item := m.item("", label, action, false)
+		item.Hint = m.gearHint(action)
+		cm.Items = append(cm.Items, item)
+	}
+	sub := func(label, target string) { add(label+" ›", "gear:"+target) }
+	switch group {
+	case "root":
+		sub("Display", "display")
+		sub("Sessions", "sessions")
+		sub("Panes", "panes")
+		sub("Workspaces", "workspaces")
+		sub("Layout", "layout")
+		sub("Copy / search", "copy")
+		sub("Tools / agents", "tools")
+		cm.Items = append(cm.Items, separator())
+		add("Keybindings", "prefix_keybinds")
+		add("Reload configuration", "reload_config")
+		add("Edit configuration", "command:edit-tuios-config")
+	case "sessions":
+		cm.Title = "Sessions"
+		add("New session", "new_session")
+		add("Switch session…", "prefix_session_switcher")
+		add("Rename session…", "rename_session")
+		add("Detach (keep processes)", "prefix_detach")
+		add("End session (confirm)…", "prefix_close_session")
+	case "panes":
+		cm.Title = "Panes"
+		add("New pane", "prefix_new_window")
+		add("Split right", "prefix_split_vertical")
+		add("Split down", "prefix_split_horizontal")
+		for _, direction := range []string{"left", "down", "up", "right"} {
+			add("Focus "+direction, "terminal_focus_"+direction)
+			add("Swap "+direction, "swap_"+direction)
+		}
+		add("Zoom / restore", "toggle_zoom")
+		add("Equalize", "equalize_splits")
+		add("Rotate split", "rotate_split")
+		sub("Move to workspace", "move")
+		add("Close pane (confirm)…", "gear:confirm-pane")
+	case "workspaces":
+		cm.Title = "Workspaces"
+		add("New workspace", "new_workspace")
+		add("Switch workspace…", "prefix_workspace_switcher")
+		add("Rename workspace…", "rename_workspace")
+		add("Close workspace (confirm)…", "gear:confirm-workspace")
+	case "layout":
+		cm.Title = "Layout"
+		current := "bsp"
+		if m.UseScrollingLayout {
+			current = "scrolling"
+		} else if !m.UseBSPLayout {
+			current = "master"
+		}
+		for _, layout := range []struct{ label, action, name string }{
+			{"BSP tiling", "gear:layout:bsp", "bsp"},
+			{"Master / stack", "gear:layout:master", "master"},
+			{"Scrolling", "gear:layout:scrolling", "scrolling"},
+		} {
+			mark := ""
+			if layout.name == current {
+				mark = " ✓"
+			}
+			add(layout.label+mark, layout.action)
+		}
+	case "move":
+		cm.Title = "Move pane to workspace"
+		for i := 1; i <= 9; i++ {
+			add(fmt.Sprintf("Workspace %d", i), fmt.Sprintf("workspace_prefix_move_%d", i))
+		}
+	case "copy":
+		cm.Title = "Copy / search"
+		add("Copy mode", "prefix_selection")
+		add("Search scrollback", "copy_mode_search_backward")
+		add("Scrollback browser", "prefix_scrollback")
+	case "tools":
+		cm.Title = "Tools / agents"
+		add("Yazi", "command:yazi")
+		add("Scratch terminal", "toggle_scratch")
+		add("Codex", "command:codex")
+		add("Command palette", "command_palette")
+		add("Sidebar / agents", "prefix_toggle_sidebar")
+		add("Inbox", "prefix_inbox")
+		add("Jump to notification", "prefix_jump_notif")
+	case "confirm-pane", "confirm-workspace":
+		cm.Title = "Stop processes?"
+		add("Cancel", "gear:root")
+		action := "prefix_close_window"
+		if group == "confirm-workspace" {
+			action = "close_workspace"
+		}
+		add("Stop processes and close", action)
+		cm.Items[len(cm.Items)-1].Warn = true
+	}
+	if group != "root" && !strings.HasPrefix(group, "confirm-") {
+		cm.Items = append(cm.Items, separator())
+		sub("Back", "root")
+	}
+	cm.Selected = cm.Next(1)
+	m.ContextMenu = cm
+}
+
+// GearAction handles only navigation; real operations use the normal dispatcher.
+func (m *OS) GearAction(action string) (bool, tea.Cmd) {
+	if !strings.HasPrefix(action, "gear:") {
+		return false, nil
+	}
+	group := strings.TrimPrefix(action, "gear:")
+	if strings.HasPrefix(group, "layout:") {
+		want := strings.TrimPrefix(group, "layout:")
+		for i := 0; i < 3; i++ {
+			current := "master"
+			if m.UseScrollingLayout {
+				current = "scrolling"
+			} else if m.UseBSPLayout {
+				current = "bsp"
+			}
+			if current == want {
+				break
+			}
+			m.ToggleLayoutMode()
+		}
+		m.OpenGearMenu("layout")
+		return true, nil
+	}
+	if group == "display" {
+		m.GearDisplay = true
+		m.OpenSettingsAt("Display")
+		m.SettingsCategory = 0
+		m.SettingsSelected = 0
+		return true, nil
+	}
+	m.OpenGearMenu(group)
+	return true, nil
+}
+
+// gearFrame overlays the same three cells on the fullscreen fast path, retaining
+// the guest's data and the fast path's terminal and graphics handling.
+func (m *OS) gearFrame(frame string) string {
+	if m.GetRenderWidth() <= 0 || m.GetRenderHeight() <= 0 {
+		return frame
+	}
+	// Parse the complete frame so a style carried across line breaks survives
+	// the gear's own reset. Cutting a row's ANSI text loses that inherited style.
+	m.gearCanvas.Resize(m.GetRenderWidth(), m.GetRenderHeight())
+	m.gearCanvas.Clear()
+	uv.NewStyledString(frame).Draw(&m.gearCanvas, m.gearCanvas.Bounds())
+	m.drawGear(&m.gearCanvas)
+	return m.gearCanvas.Render()
+}
+
+// gearHint prefers a live global binding, then a complete prefix chord. The
+// registry's ordinary context-menu hint omits global-only command bindings.
+func (m *OS) gearHint(action string) string {
+	if m.KeybindRegistry == nil {
+		return ""
+	}
+	best, rank := "", 99
+	for _, binding := range m.KeybindRegistry.Bindings() {
+		if binding.Action != action || binding.Unbound || binding.Shadowed || binding.Press == "" {
+			continue
+		}
+		candidateRank := 99
+		if binding.Scope == config.ScopeGlobal {
+			candidateRank = 0
+		} else if strings.Contains(binding.Press, " ") {
+			candidateRank = 1
+		} else if binding.Scope == config.ScopeWindowMode {
+			candidateRank = 2
+		}
+		if candidateRank < rank || (candidateRank == rank && len(binding.Press) < len(best)) {
+			best, rank = binding.Press, candidateRank
+		}
+	}
+	if rank == 2 {
+		return best + " (window mode)"
+	}
+	if rank == 99 {
+		return ""
+	}
+	return best
+}
+
+func (m *OS) gearText() string {
+	pal := theme.GroundUI()
+	glyph := "  "
+	if m.Settings.UseASCIIOnly {
+		glyph = " * "
+	}
+	return ansi.Truncate(lipgloss.NewStyle().Foreground(pal.Fg).Render(glyph), max(0, m.GetRenderWidth()), "")
+}
+
+// drawGear replaces only the gear's three cells, retaining the actual background
+// already drawn beneath each one. It never paints a separate surface or fill.
+func (m *OS) drawGear(canvas *frameCanvas) {
+	if m.GetRenderWidth() <= 0 || m.GetRenderHeight() <= 0 {
+		return
+	}
+	// Match the compositor's transparent overlay: retain the background of
+	// the underlying terminal or bar, rather than replacing it with a fill.
+	var behind [3]uv.Cell
+	for i := range min(3, m.GetRenderWidth()) {
+		if cell := canvas.CellAt(m.gearX()+i, m.gearY()); cell != nil {
+			behind[i] = *cell
+		}
+	}
+	uv.NewStyledString(m.gearText()).Draw(canvas,
+		image.Rect(m.gearX(), m.gearY(), m.GetRenderWidth(), m.gearY()+1))
+	for i := range min(3, m.GetRenderWidth()) {
+		if cell := canvas.CellAt(m.gearX()+i, m.gearY()); cell != nil {
+			cell.Style.Bg = behind[i].Style.Bg
+		}
+	}
+}
