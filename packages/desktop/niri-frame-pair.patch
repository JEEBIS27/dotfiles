+    fn begin_pair_anchor(&mut self, col_idx: usize, right_edge: bool) {
+        if self.pair_anchor.is_some() {
+            return;
+        }
+        let col = &self.columns[col_idx];
+        let tile = &col.tiles[col.active_tile_idx];
+        let tile_x = col.tiles().find(|(t, _)| t.window().id() == tile.window().id())
+            .map(|(_, pos)| pos.x).unwrap_or(0.);
+        let edge = self.column_x(col_idx) + col.render_offset().x + tile_x
+            + tile.render_offset().x
+            + if right_edge { tile.animated_tile_size().w } else { 0. };
+        self.pair_anchor = Some(PairResizeAnchor {
+            window: tile.window().id().clone(), right_edge,
+            screen_edge: edge - self.view_pos(),
+            initial_width: tile.tile_size().w,
+            started: false,
+            deadline: self.clock.now_unadjusted() + Duration::from_secs(2),
+        });
+    }
+
+    fn anchored_view_pos(&self, animated: bool) -> Option<f64> {
+        let anchor = self.pair_anchor.as_ref()?;
+        self.columns.iter().enumerate().find_map(|(idx, col)| {
+            col.tiles().find(|(tile, _)| tile.window().id() == &anchor.window)
+                .map(|(tile, pos)| {
+                    let width = if animated { tile.animated_tile_size().w } else { tile.tile_size().w };
+                    let offset = if animated { col.render_offset().x + tile.render_offset().x } else { 0. };
+                    self.column_x(idx) + pos.x + offset
+                        + if anchor.right_edge { width } else { 0. }
+                        - anchor.screen_edge
+                })
+        })
+    }
