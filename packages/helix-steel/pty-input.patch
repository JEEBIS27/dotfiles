 (define ctrl-l (string->key-event "C-l"))
 
 ;; Event handler for the terminal.
+;; Translate Helix key events into terminal input instead of dropping Ctrl/Alt.
+(define (terminal-modifier? event flag)
+  (not (= 0 (bitwise-and (or (key-event-modifier event) 0) flag))))
+(define (terminal-csi-modifier event)
+  (+ 1 (if (terminal-modifier? event key-modifier-shift) 1 0)
+       (if (terminal-modifier? event key-modifier-alt) 2 0)
+       (if (terminal-modifier? event key-modifier-ctrl) 4 0)
+       (if (terminal-modifier? event key-modifier-super) 8 0)))
+(define (terminal-csi-u event code)
+  (string-append "\x1b;[" (number->string code) ";" (number->string (terminal-csi-modifier event)) "u"))
+(define (terminal-navigation event suffix)
+  (string-append "\x1b;[" (if (= (terminal-csi-modifier event) 1) "" (string-append "1;" (number->string (terminal-csi-modifier event)))) suffix))
+(define (terminal-tilde event code)
+  (string-append "\x1b;[" (number->string code)
+    (if (= (terminal-csi-modifier event) 1) "" (string-append ";" (number->string (terminal-csi-modifier event)))) "~"))
+(define (terminal-paste process text)
+  ;; Keep pasted newlines as editing input, not immediately executed commands.
+  (pty-process-send-command process (string-append "\x1b;[200~" text "\x1b;[201~")))
+(define (terminal-key-string event)
+  (define char (key-event-char event))
+  (define ctrl? (terminal-modifier? event key-modifier-ctrl))
+  (define alt? (terminal-modifier? event key-modifier-alt))
+  (define shift? (terminal-modifier? event key-modifier-shift))
+  (define modified? (or ctrl? alt? (terminal-modifier? event key-modifier-super)))
+  (cond
+    [(key-event-escape? event) (if modified? (terminal-csi-u event 27) "\x1b;")]
+    [(key-event-backspace? event) (if modified? (terminal-csi-u event 127) "\x7f;")]
+    [(key-event-enter? event) (if (or modified? shift?) (terminal-csi-u event 13) "\r")]
+    [(key-event-tab? event) (cond [modified? (terminal-csi-u event 9)] [shift? "\x1b;[Z"] [else "\t"])]
+    [(key-event-up? event) (terminal-navigation event "A")]
+    [(key-event-down? event) (terminal-navigation event "B")]
+    [(key-event-right? event) (terminal-navigation event "C")]
+    [(key-event-left? event) (terminal-navigation event "D")]
+    [(key-event-home? event) (terminal-navigation event "H")]
+    [(key-event-end? event) (terminal-navigation event "F")]
+    [(key-event-insert? event) (terminal-tilde event 2)]
+    [(key-event-delete? event) (terminal-tilde event 3)]
+    [(key-event-page-up? event) (terminal-tilde event 5)]
+    [(key-event-page-down? event) (terminal-tilde event 6)]
+    [char
+      (define lower (char-downcase char))
+      (define code (char->integer lower))
+      (cond
+        [(and ctrl? (not shift?) (not (terminal-modifier? event key-modifier-super))
+              (or (and (>= code 97) (<= code 122)) (and (>= code 64) (<= code 95)) (equal? char #\space)))
+          (string-append (if alt? "\x1b;" "")
+            (string (integer->char (if (equal? char #\space) 0 (modulo code 32)))))]
+        [(or ctrl? (terminal-modifier? event key-modifier-super)) (terminal-csi-u event code)]
+        [else (string-append (if alt? "\x1b;" "") (string char))])]
+    [else
+      (let loop ([n 1] [codes '(11 12 13 14 15 17 18 19 20 21 23 24)])
+        (cond [(null? codes) #f]
+              [(key-event-F? event n)
+                (if (<= n 4)
+                    (if (= (terminal-csi-modifier event) 1)
+                        (string-append "\x1b;O" (list-ref '("P" "Q" "R" "S") (- n 1)))
+                        (terminal-navigation event (list-ref '("P" "Q" "R" "S") (- n 1))))
+                    (terminal-tilde event (car codes)))]
+              [else (loop (+ n 1) (cdr codes))]))]))
+
